// WiFi credentials — copy this file to secrets.h and fill in your values.
// secrets.h is gitignored and never committed.
// AP_SSID must be identical on every node so phones roam between them.
// AP_PASSWORD must be "" (open) or >= 8 characters for WPA2.

#pragma once

#define AP_SSID     "YourNetworkName"
#define AP_PASSWORD "YourPassword"
