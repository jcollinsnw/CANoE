// WiFi + ESP-NOW credentials — copy this file to secrets.h and fill in your values.
// secrets.h is gitignored and never committed.
// AP_SSID must be identical on every node so phones roam between them.
// AP_PASSWORD must be "" (open) or >= 8 characters for WPA2.
// ESP-NOW keys must be identical on every node — change from defaults before field use.

#pragma once

#define AP_SSID     "YourNetworkName"
#define AP_PASSWORD "YourPassword"

// ESP-NOW encryption keys — 16 bytes each, must match on every node.
#define ESPNOW_PMK "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
#define ESPNOW_LMK "\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
